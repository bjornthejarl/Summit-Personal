NEXT_PUBLIC_URL="your-public-url.com"
# Authentication
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
CLIENT_AUTH_SECRET="client-auth-secret"

# Database
DATABASE_URL="postgresql://someuser:somepass@test.summitfinance.app/summit?sslmode=require"

# Email (SMTP - Zoho Mail or other providers)
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@zoho.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@zoho.com"
SMTP_FROM_NAME="Summit Finance"

# Xendit Payment Integration (Optional - can be left empty for deployment without payments)
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_VERIFICATION_TOKEN=""

# Cron Jobs
CRON_API_KEY="your-secure-cron-api-key"

# Minio S3 Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=summit

# DISABLE NEXT TELEMETRY (up to you, this allow your service to sleep!)
NEXT_TELEMETRY_DISABLED=1

# Set to "1" to disable new user signups
NEXT_PUBLIC_DISABLE_SIGNUP=1
